<Window x:Class="EcoPulse.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EcoPulse.Dashboard"
        Title="EcoPulse OSB"
        Width="1200"
        Height="760"
        MinWidth="360"
        MinHeight="520"
        Background="#181A1F"
        FontFamily="Segoe UI"
        Foreground="#E4E7EB"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#21262D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B939E"/>
        <SolidColorBrush x:Key="VoltageBrush" Color="#2B90D9"/>
        <SolidColorBrush x:Key="CurrentBrush" Color="#2ECC71"/>
        <SolidColorBrush x:Key="TemperatureBrush" Color="#E67E22"/>
        <SolidColorBrush x:Key="LineBrush" Color="#3A424E"/>
        <Style x:Key="DataReadout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E4E7EB"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2A313A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#323B48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B90D9"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B313A"/>
                                <Setter Property="Foreground" Value="#6E7680"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="#14171C"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
        </Style>
        <DataTemplate DataType="{x:Type local:MachineRow}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:AlarmRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{Binding BadgeBrush}" CornerRadius="2" Margin="0,2"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding LossText}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Border Background="{Binding BadgeSoftBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding BadgeBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer x:Name="RootScroll"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="False"
                  Background="Transparent">
    <Grid x:Name="RootGrid" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TitleBlock">
                <TextBlock Text="EcoPulse OSB" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Akıllı enerji kaçağı ve ısı kaybı erken uyarı" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="NormalButton" Content="Normal" Style="{StaticResource RunButton}" Margin="0,0,8,0" Click="NormalButton_Click"/>
                <Button x:Name="FaultButton" Content="Arıza bas" Style="{StaticResource DangerButton}" Margin="0,0,16,0" Click="FaultButton_Click"/>
                <Rectangle x:Name="LiveDot" Width="8" Height="8" Fill="#27AE60" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="KpiGrid" Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="KpiMachines" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KAYITLI MAKİNE" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="MachineCountText" Style="{StaticResource DataReadout}" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border x:Name="KpiPower" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ANLIK TOPLAM GÜÇ" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="PowerText" Style="{StaticResource DataReadout}" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border x:Name="KpiCo2" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DOĞRULANAN CO₂" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="Co2Text" Style="{StaticResource DataReadout}" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                    <TextBlock Text="Model tahmini · kg/saat" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="KpiSavings" Grid.Column="3" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12"
                    ToolTip="Alarmdaki tahmini kayıp oranı, müdahale sonrasında 3 ardışık normal ölçümle doğrulanır.">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KESİLEN KAYIP" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="VerifiedSavingsText" Style="{StaticResource DataReadout}" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </Viewbox>
                    <TextBlock Text="Model tahmini · TL/saat" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="KpiLoss" Grid.Column="4" Style="{StaticResource CardBorder}" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AKTİF KAYIP" Style="{StaticResource DataReadout}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34" Margin="0,6,0,0">
                        <TextBlock x:Name="LossText" Style="{StaticResource DataReadout}" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </Viewbox>
                    <TextBlock x:Name="DailyLossText" Style="{StaticResource DataReadout}" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="200"/>
                <ColumnDefinition Width="2.5*" MinWidth="280"/>
                <ColumnDefinition Width="1.45*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="MachinePanel" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TESİS" Style="{StaticResource DataReadout}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>
                    <ListBox x:Name="MachineList" Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="MachineList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Grid x:Name="ChartPanel" Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ChartTitleText" Text="Telemetri" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,10"/>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Voltaj" Style="{StaticResource DataReadout}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VoltageValueText" Style="{StaticResource DataReadout}" HorizontalAlignment="Right" Foreground="{StaticResource VoltageBrush}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="VoltageChart" Grid.Row="1" LineBrush="{StaticResource VoltageBrush}" MinHeight="80"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Akım" Style="{StaticResource DataReadout}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentValueText" Style="{StaticResource DataReadout}" HorizontalAlignment="Right" Foreground="{StaticResource CurrentBrush}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="CurrentChart" Grid.Row="1" LineBrush="{StaticResource CurrentBrush}" MinHeight="80"/>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Sıcaklık" Style="{StaticResource DataReadout}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TemperatureValueText" Style="{StaticResource DataReadout}" HorizontalAlignment="Right" Foreground="{StaticResource TemperatureBrush}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="TemperatureChart" Grid.Row="1" LineBrush="{StaticResource TemperatureBrush}" MinHeight="80"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="AlarmPanel" Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                        <TextBlock Text="ALARMLAR" Style="{StaticResource DataReadout}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="MaintenanceButton" Content="Bakım Bildir" Style="{StaticResource PrimaryButton}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Click="MaintenanceButton_Click" IsEnabled="False"/>
                    </DockPanel>
                    <TextBlock x:Name="WorkOrderText" DockPanel.Dock="Bottom" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="EmptyAlarmText" DockPanel.Dock="Top" Text="Henüz alarm yok. Simülasyon normal akışta."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="AlarmList" Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="AlarmList_SelectionChanged"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap"
                   Text="Simülasyon ve yerel veritabanı uygulamaya dahildir."/>
    </Grid>
    </ScrollViewer>
</Window>
