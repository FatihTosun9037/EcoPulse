<Window x:Class="EcoPulse.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EcoPulse.Dashboard"
        Title="EcoPulse OSB"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="#0F1714"
        FontFamily="Segoe UI"
        Foreground="#E7F3EC"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#17241F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8EAAA0"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A3D34"/>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E7F3EC"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1A2C26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1E3D34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3DDC97"/>
            <Setter Property="Foreground" Value="#0F1714"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#62E8B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#24332C"/>
                                <Setter Property="Foreground" Value="#6E8A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type local:MachineRow}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:AlarmRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{Binding BadgeBrush}" CornerRadius="2" Margin="0,2"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding LossText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Border Background="{Binding BadgeSoftBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,0,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding BadgeBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="EcoPulse OSB" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Akıllı enerji kaçağı ve ısı kaybı erken uyarı" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,2">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#3DDC97" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AKTİF MAKİNE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="MachineCountText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ANLIK TOPLAM GÜÇ" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="PowerText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ENGELLENEN CO₂" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,6,0,0">
                        <TextBlock x:Name="Co2Text" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    </Viewbox>
                    <TextBlock Text="Kapanan alarmlar" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AKTİF KAYIP" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34" Margin="0,6,0,0">
                        <TextBlock x:Name="LossText" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </Viewbox>
                    <TextBlock x:Name="DailyLossText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="200"/>
                <ColumnDefinition Width="2.5*" MinWidth="280"/>
                <ColumnDefinition Width="1.45*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TESİS" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>
                    <ListBox x:Name="MachineList" Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="MachineList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ChartTitleText" Text="Telemetri" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,10"/>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Voltaj" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VoltageValueText" HorizontalAlignment="Right" Foreground="#78BEFF" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="VoltageChart" Grid.Row="1" LineBrush="#78BEFF" MinHeight="80"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Akım" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentValueText" HorizontalAlignment="Right" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="CurrentChart" Grid.Row="1" LineBrush="#3DDC97" MinHeight="80"/>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Sıcaklık" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TemperatureValueText" HorizontalAlignment="Right" Foreground="#F5C451" FontWeight="SemiBold"/>
                        </DockPanel>
                        <local:Sparkline x:Name="TemperatureChart" Grid.Row="1" LineBrush="#F5C451" MinHeight="80"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                        <TextBlock Text="ALARMLAR" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="MaintenanceButton" Content="Bakım Bildir" Style="{StaticResource PrimaryButton}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Click="MaintenanceButton_Click" IsEnabled="False"/>
                    </DockPanel>
                    <TextBlock x:Name="WorkOrderText" DockPanel.Dock="Bottom" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="EmptyAlarmText" DockPanel.Dock="Top" Text="Henüz alarm yok. Simülasyon normal akışta."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="AlarmList" Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="AlarmList_SelectionChanged"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Text="Simülasyon ve yerel veritabanı uygulamaya dahildir."/>
    </Grid>
</Window>
